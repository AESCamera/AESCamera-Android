<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AESCamera" parent="Theme.Material3.DayNight">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.AESCamera" parent="Base.Theme.AESCamera" />

    <!-- Circular clip for contact avatars in the WhatsApp picker (item_contact). -->
    <style name="ShapeAppearanceOverlay.AESCamera.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--
      Previous/next control shared by the image viewer and the video player, so both
      screens navigate the gallery with identical buttons. Borderless white icon on a
      ripple, styled to sit alongside Media3's own player controls (skip-previous /
      skip-next glyphs, same tint and weight).
    -->
    <style name="GalleryNavButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">26sp</item>
        <item name="android:elevation">2dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>
</resources>